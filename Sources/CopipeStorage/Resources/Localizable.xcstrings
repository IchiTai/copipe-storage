    "guide.paste_failed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not paste"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けできませんでした"
          }
        }
      }
    },
    "guide.paste_failed.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clip's data could not be found, so nothing was pasted. The clip has been removed from the history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このクリップのデータが見つからないため貼り付けできませんでした。履歴から取り除きました。"
          }
        }
      }
    },
