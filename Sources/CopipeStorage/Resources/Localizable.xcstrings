{
  "sourceLanguage": "ja",
  "strings": {
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copipe Storage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピペストレージ"
          }
        }
      }
    },
    "menu.quit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Copipe Storage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピペストレージを終了"
          }
        }
      }
    },
