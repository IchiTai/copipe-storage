    "time.yesterday": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日 %@"
          }
        }
      }
    },
    "guide.permission.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste permission is missing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けの権限がありません"
          }
        }
      }
    },
    "guide.permission.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clip is on the clipboard. Press ⌘V to paste it.\nTo paste automatically, allow Copipe Storage in System Settings > Privacy & Security > Accessibility."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップはクリップボードに載せました。⌘V で貼り付けてください。\n選んだときに自動で貼り付けるには、システム設定の「プライバシーとセキュリティ」>「アクセシビリティ」でコピペストレージを許可してください。"
          }
        }
      }
    },
    "guide.copied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied to the clipboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードに載せました"
          }
        }
      }
    },
    "guide.copied.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target app could not be brought forward, so nothing was pasted automatically. Press ⌘V to paste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り先のアプリに切り替えられなかったため、自動では貼り付けていません。⌘V で貼り付けてください。"
          }
        }
      }
    },
    "guide.open_settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        }
      }
    },
    "guide.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "menu.settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定…"
          }
        }
      }
    },
    "menu.clear_all": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear All History…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴をすべて消去…"
          }
        }
      }
    },
    "clear_all.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear all history?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴をすべて消去しますか？"
          }
        }
      }
    },
    "clear_all.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every saved clip will be removed. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されているクリップがすべて消えます。この操作は取り消せません。"
          }
        }
      }
    },
    "clear_all.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
