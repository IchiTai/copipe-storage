        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呼び出しのショートカット:"
          }
        }
      }
    },
    "settings.launch_at_login": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動"
          }
        }
      }
    },
    "settings.launch_at_login.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the app to the Applications folder before turning this on. Moving it later breaks the registration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを「アプリケーション」フォルダに置いてからオンにしてください。場所を移すと登録が外れます。"
          }
        }
      }
    },
    "settings.launch_at_login.requires_approval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval in System Settings is required."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定での許可が必要です。"
          }
        }
      }
    },
    "settings.open_login_items": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Login Items"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目を開く"
          }
        }
      }
    },
    "settings.max_clips": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History limit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴の件数上限"
          }
        }
      }
    },
    "settings.max_clips.unit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "clips"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "件"
          }
        }
      }
    },
    "settings.max_clips.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld to %lld clips. Older clips are removed first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld〜%lld 件。超えた分は使った順の古いものから消えます。"
          }
        }
      }
    },
    "about.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@"
          }
        }
      }
    },
    "about.libraries": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Libraries"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用しているライブラリ"
          }
        }
      }
    },
    "panel.copy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー"
          }
        }
      }
    },
    "guide.read_denied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read the clipboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードを読み取れません"
          }
        }
      }
    },
    "guide.read_denied.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is not allowing Copipe Storage to read the clipboard, so new clips cannot be captured. Allow Copipe Storage in System Settings > Privacy & Security > Paste from Other Apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の設定でコピペストレージの読み取りが許可されていないため、履歴を取り込めません。システム設定の「プライバシーとセキュリティ」>「他のアプリからペースト」でコピペストレージを許可してください。"
          }
        }
      }
    },
    "alert.already_running.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copipe Storage is already running"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピペストレージはすでに起動しています"
          }
        }
      }
    },
    "alert.already_running.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit the running Copipe Storage, then open it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動中のコピペストレージを終了してから、もう一度開いてください。"
          }
        }
      }
    },
